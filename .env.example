# Required: shared secret between the Hermes dashboard and the Vibe City backend (both live in the same container).
HERMES_DASHBOARD_SESSION_TOKEN=
# NEAR AI Cloud: the default model provider of the container (OpenAI-compatible endpoint). Key from https://cloud.near.ai
NEAR_AI_API_KEY=
# NEAR_AI_MODEL=deepseek/deepseek-v4.1-flash   # default model for a fresh Hermes home
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# NEAR_AI_REASONING_EFFORT=high   # low|high|xhigh|max; DeepSeek V4.x on NEAR rejects Hermes' default "medium"
# Optional
# VIBE_CITY_PORT=4100
# HERMES_IMAGE=nousresearch/hermes-agent@sha256:...   # default: the pinned digest in the Dockerfile (Hermes 0.22.6)
# HERMES_UID=1000
# HERMES_GID=1000
# Model credentials for Hermes go in .env.hermes (see Hermes docs for the variable names of your provider).
