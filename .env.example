# Required: shared secret between the Hermes dashboard and the Vibe City backend (both live in the same container).
HERMES_DASHBOARD_SESSION_TOKEN=
# NEAR AI Cloud: the default model provider of the container (OpenAI-compatible endpoint). Key from https://cloud.near.ai
# Optional: leave it empty and paste the key in the game's first quest (Set up your Chief of Staff) instead.
NEAR_AI_API_KEY=
# NEAR_AI_MODEL=deepseek/deepseek-v4.1-flash   # default model for a fresh Hermes home (and the Chief of Staff's until you pick one)
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# NEAR_AI_REASONING_EFFORT=high   # low|high|xhigh|max; DeepSeek V4.x on NEAR rejects Hermes' default "medium"
# Optional
# VIBE_CITY_PORT=4100
# HERMES_IMAGE=nousresearch/hermes-agent@sha256:...   # default: the pinned digest in the Dockerfile (Hermes 0.22.6)
# HERMES_UID=1000
# HERMES_GID=1000
# Model credentials for Hermes go in .env.hermes (see Hermes docs for the variable names of your provider).

# The safe in the Executive Office (wallets, treasury, credits). All optional.
# Agent credits: NEAR AI Cloud's billing needs your organization id and a session token from cloud.near.ai
# (the API key above cannot read billing). Server-side only, never sent to the browser.
# NEAR_AI_ORG_ID=
# NEAR_AI_ACCESS_TOKEN=
# NEAR RPC endpoints (defaults: FastNEAR public RPC)
# NEAR_RPC_MAINNET=https://rpc.mainnet.fastnear.com
# NEAR_RPC_TESTNET=https://rpc.testnet.fastnear.com
