#!/bin/sh
# The `hermes` CLI of the dev container (docker-compose.dev.yml), for a backend running on the host: HERMES_BIN=scripts/hermes-docker.
# Runs as the hermes user against the container's data, like the backend does inside the production image.
# Native engine, not Docker Desktop: its VM can't reach the host backend, and two Hermes on one .dev/hermes corrupt it.
exec env DOCKER_CONTEXT="${DOCKER_CONTEXT:-default}" docker exec -i -u hermes -e HOME=/opt/data -e COLUMNS="${COLUMNS:-250}" -e NO_COLOR=1 \
  "${HERMES_DEV_CONTAINER:-vibe-city-hermes-dev}" hermes "$@"
