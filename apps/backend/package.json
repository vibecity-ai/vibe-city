{
  "name": "@vibe-city/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "dev:docker": "HERMES_BIN=../../scripts/hermes-docker node --env-file-if-exists=../../.env --watch --experimental-strip-types src/server.ts",
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "gate0": "node --experimental-strip-types scripts/gate0.ts",
    "m2:integration": "node --experimental-strip-types scripts/m2-integration.ts",
    "m3:integration": "node --experimental-strip-types scripts/m3-integration.ts",
    "demo": "node --experimental-strip-types scripts/demo-server.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "@vibe-city/shared": "*",
    "fastify": "^5.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0"
  }
