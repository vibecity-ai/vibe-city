#!/command/with-contenv sh
# shellcheck shell=sh
# NEAR AI Cloud as the default model provider (OpenAI-compatible endpoint), configured from the environment.
#
#   NEAR_AI_API_KEY   optional here: the CEO can paste the key in the game's first quest instead, and Vibe City writes
#                     it into every agent profile's .env (Hermes reads it via key_env at call time). Not written by this
#                     script either way.
#   NEAR_AI_BASE_URL  default https://cloud-api.near.ai/v1
#   NEAR_AI_MODEL     default model for a fresh Hermes home, default deepseek/deepseek-v4.1-flash
#   NEAR_AI_REASONING_EFFORT  default high. Hermes' built-in "medium" is rejected by DeepSeek V4.x on NEAR
#                     (HTTP 400: must be low, high, xhigh, max or 1-100), so it is replaced wherever it is in effect
#
# Runs after Hermes' own setup (01/015/02) and before any service. Idempotent:
#   - the providers.near-ai block is (re)written in the main config and in every existing profile, so profiles
#     cloned before NEAR was configured can use it too;
#   - model.provider/model.default are only set (main config and every profile) while no provider has been chosen
#     (unset or "auto"), so a choice made later in Hermes or in Vibe City is never overwritten on restart.

# The provider is configured with or without the key: it only names the variable (key_env) the key is read from.
if [ -z "${NEAR_AI_API_KEY:-}" ]; then
    echo "[vibe-city] NEAR_AI_API_KEY is not set; NEAR AI Cloud is configured and waits for the key from the game."
fi

HERMES_HOME="${HERMES_HOME:-/opt/data}"
base_url="${NEAR_AI_BASE_URL:-https://cloud-api.near.ai/v1}"
model="${NEAR_AI_MODEL:-deepseek/deepseek-v4.1-flash}"
effort="${NEAR_AI_REASONING_EFFORT:-high}"

# Hermes CLI as the hermes user, against the shared volume. $1 = profile ("" = main config).
h() {
    p="$1"; shift
    if [ -n "$p" ]; then set -- -p "$p" "$@"; fi
    HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" s6-setuidgid hermes hermes "$@"
}
get() { h "$1" config get "$2" 2>/dev/null | tail -n 1 | tr -d '[:space:]'; }

configure_provider() {
    api="$(get "$1" providers.near-ai.api)"
    if [ "$api" = "$base_url" ] && [ "$(get "$1" providers.near-ai.key_env)" = NEAR_AI_API_KEY ]; then
        return 0
    fi
    # A department profile the backend pointed at its metering proxy (/ai/v1) holds a proxy key, not a NEAR AI key:
    # putting the NEAR AI URL back would break it.
    case "$api" in */ai/v1) return 0 ;; esac
    h "$1" config set providers.near-ai.name "NEAR AI Cloud" >/dev/null &&
    h "$1" config set providers.near-ai.api "$base_url" >/dev/null &&
    h "$1" config set providers.near-ai.key_env NEAR_AI_API_KEY >/dev/null &&
    h "$1" config set providers.near-ai.transport chat_completions >/dev/null &&
    echo "[vibe-city] NEAR AI Cloud provider configured${1:+ for profile $1}."
}

# `config get` prints Hermes' built-in "medium" when agent.reasoning_effort is unset.
configure_reasoning() {
    if [ "$(get "$1" agent.reasoning_effort)" = medium ]; then
        h "$1" config set agent.reasoning_effort "$effort" >/dev/null 2>&1 &&
        echo "[vibe-city] Reasoning effort set to $effort${1:+ for profile $1}."
    fi
}

configure_model() {
    case "$(get "$1" model.provider)" in
        ""|auto|null|None)
            h "$1" config set model.provider near-ai >/dev/null &&
            h "$1" config set model.default "$model" >/dev/null &&
            echo "[vibe-city] Default model set to $model on NEAR AI Cloud${1:+ for profile $1}."
            ;;
    esac
}

configure_provider ""
configure_reasoning ""
configure_model ""

for dir in "$HERMES_HOME"/profiles/*/; do
    [ -d "$dir" ] || continue
    configure_provider "$(basename "$dir")"
    configure_reasoning "$(basename "$dir")"
    configure_model "$(basename "$dir")"
done
exit 0
